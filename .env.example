# Copy this file to .env and fill it in. .env is never committed. Names only here: never put real secrets in this file.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Server ---
PORT=3100
SESSION_SECRET=
ADMIN_PIN=

# --- Cash float (IMPORTANT) ---
# The fixed petty-cash / opening float used by Cash Proof and Petty Cash. If this line is missing the float is 0 and the cash screens are wrong.
# The server prints a WARNING at start-up when it is not set. Example for Royal Bath Hub: PETTY_CASH_FLOAT=25000
PETTY_CASH_FLOAT=

# --- Backups ---
# Folder for the encrypted off-machine copy of each daily backup (USB drive, OneDrive/Google Drive folder, network share).
BACKUP_COPY_DIR=
# Passphrase (8+ characters) used to encrypt those copies with AES-256-GCM. Keep it ALSO in a password manager: without it the copies cannot be opened.
# If either BACKUP_COPY_DIR or BACKUP_PASSPHRASE is empty, nothing is copied and a warning is printed.
BACKUP_PASSPHRASE=
# Optional: login that may CREATE DATABASE, used only by scripts/restore_encrypted_backup.js (defaults to DB_USER / DB_PASSWORD).
RESTORE_PGUSER=
RESTORE_PGPASSWORD=

# --- Optional ---
# Maximum shared database connections (default 15).
PG_POOL_MAX=

# Layla owner assistant (Build 2). Values are filled by the owner, never committed.
OWNER_WA_NUMBER=
# For WhatsApp later (see BUILD2 section 5):
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
RELAY_URL=
RELAY_SECRET=
LAYLA_OWNER_LIVE=false   # set true only after testing
