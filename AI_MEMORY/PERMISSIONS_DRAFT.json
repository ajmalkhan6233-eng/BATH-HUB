{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "WebSearch", "WebFetch",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git fetch:*)",
      "Bash(git pull:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(git mv:*)",
      "Bash(ls:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(mkdir:*)",
      "Bash(node -c:*)", "Bash(node --check:*)", "Bash(npm test:*)", "Bash(npm run test:*)",
      "Bash(npm run build:*)", "Bash(npm run lint:*)", "Bash(npm ci:*)", "Bash(npx jest:*)",
      "Bash(flutter analyze:*)", "Bash(flutter test:*)", "Bash(flutter build:*)", "Bash(flutter pub get:*)",
      "Bash(dart analyze:*)", "Bash(dart format:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)", "Bash(git push origin -f:*)",
      "Bash(git push -u origin --force:*)", "Bash(git push -u origin -f:*)",
      "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)", "Bash(rm -rf ..:*)", "Bash(rm -rf ../:*)",
      "Bash(cat .env:*)", "Bash(cat ./.env:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(**/.env)", "Read(**/.env.*)",
      "Read(./.pg_*)", "Read(./.test-login.txt)", "Read(./TEMP_PASSWORDS.txt)",
      "Read(**/*.pem)", "Read(**/*.key)", "Read(**/secrets/**)"
    ]
  }
}
